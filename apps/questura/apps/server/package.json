{
  "name": "@questura/server",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm generate:types && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "node scripts/show-commands.cjs && cross-env NODE_OPTIONS='--no-deprecation --no-warnings=ExperimentalWarning' next dev -p 4000",
    "devsafe": "rm -rf .next && node scripts/show-commands.cjs && cross-env NODE_OPTIONS=--no-deprecation next dev -p 4000",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "backfill:rankings": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/backfill-rankings-created-by.ts",
    "clear:test": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/clear-test-collections.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.64.0",
    "@payloadcms/email-resend": "^3.64.0",
    "@payloadcms/next": "3.64.0",
    "@payloadcms/payload-cloud": "3.64.0",
    "@payloadcms/plugin-cloud-storage": "3.64.0",
    "@payloadcms/richtext-lexical": "3.64.0",
    "@payloadcms/ui": "3.64.0",
    "@seshuk/payload-storage-bunny": "^2.1.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/stripe": "^8.0.417",
    "bcryptjs": "^3.0.2",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "jsonwebtoken": "^9.0.2",
    "next": "15.5.9",
    "payload": "3.64.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.5.4",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.4.4",
    "jsdom": "26.1.0",
    "prettier": "^3.4.2",
    "stripe": "^18.4.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.3"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
