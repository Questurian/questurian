{
  "name": "@questura/server",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm generate:types && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "node scripts/show-commands.cjs && cross-env NODE_OPTIONS='--no-deprecation --no-warnings=ExperimentalWarning' next dev -p 4000",
    "devsafe": "rm -rf .next && node scripts/show-commands.cjs && cross-env NODE_OPTIONS=--no-deprecation next dev -p 4000",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "db:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "db:migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "db:migrate:down": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:down",
    "db:migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "reconcile:stripe-profiles": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/reconcile-stripe-visitor-profiles.ts",
    "audit:access-revocations": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/audit-access-revocations.ts",
    "set:itinerary-access": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/set-itinerary-access.ts",
    "capture:membership-fixtures": "bun scripts/capture-membership-fixtures.ts",
    "inventory:tour-agency": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/inventory-tour-agency-stops.ts",
    "migrate:media-sets": "bun scripts/finish-media-set-migration.ts",
    "migrate:nightlife-contract-v2": "bun scripts/migrate-nightlife-contract-v2.ts",
    "clear:payload:except-users": "cross-env NODE_OPTIONS=--no-deprecation bun scripts/clear-payload-except-users.ts",
    "clear:attractions": "cross-env NODE_OPTIONS=--no-deprecation bun src/scripts/clear-attractions.ts",
    "clear:homepage-blocks": "cross-env NODE_OPTIONS=--no-deprecation bun src/scripts/clear-homepage-blocks.ts",
    "bootstrap:currencies": "cross-env NODE_OPTIONS=--no-deprecation bun src/scripts/bootstrap-currencies.ts",
    "seed:currencies": "cross-env NODE_OPTIONS=--no-deprecation bun src/scripts/seed-currencies.ts",
    "seed:locations": "cross-env NODE_OPTIONS=--no-deprecation bun src/scripts/seed-locations.ts",
    "sync:exchange-rates": "cross-env NODE_OPTIONS=--no-deprecation bun src/scripts/sync-exchange-rates.ts",
    "clear:test": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/clear-test-collections.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:int && pnpm run test:deploy && pnpm run test:softprod",
    "test:deploy": "node --test scripts/deploy/*.test.mjs",
    "test:softprod": "bash ../../infra/softprod/deploy.test.sh && bash ../../infra/softprod/release-lib.test.sh && bash ../../infra/softprod/stage-host-config.test.sh && bash ../../infra/softprod/prepare-host-release.test.sh && bash ../../infra/softprod/adopt-host-release.test.sh && bash ../../infra/softprod/healthcheck.test.sh",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.79.1",
    "@payloadcms/email-resend": "3.79.1",
    "@payloadcms/next": "3.79.1",
    "@payloadcms/payload-cloud": "3.79.1",
    "@payloadcms/plugin-cloud-storage": "3.79.1",
    "@payloadcms/richtext-lexical": "3.79.1",
    "@payloadcms/ui": "3.79.1",
    "@seshuk/payload-storage-bunny": "^2.1.1",
    "@types/pg": "^8.20.0",
    "@types/stripe": "^8.0.417",
    "bcryptjs": "^3.0.2",
    "better-auth": "^1.6.11",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "ioredis": "^5.11.0",
    "next": "15.4.11",
    "payload": "3.79.1",
    "pg": "^8.21.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.5.4",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "9.16.0",
    "eslint-config-next": "15.4.11",
    "jsdom": "26.1.0",
    "prettier": "^3.4.2",
    "stripe": "^18.4.0",
    "tsx": "^4.19.0",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.6"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  }
}
