{
  "name": "campaign-reader",
  "description": "One campaign visitor: lands on a public page, reads, opens one more page. Two pages per visit, 90 s between them (a 180 s visit). Each page is the HTML document plus the anonymous identity check the navigation makes. Assets, RSC prefetch and images are not included and must be accounted for separately.",
  "iterations": [
    {
      "name": "city then article",
      "weight": 5,
      "steps": [
        {
          "name": "page: city",
          "target": "client",
          "path": "/peru/lima?utm_source=campaign&utm_medium=social",
          "expect": {
            "body": "html",
            "minBytes": 5000
          }
        },
        {
          "name": "identity",
          "target": "server",
          "path": "/api/me",
          "expect": {
            "status": [
              200,
              401
            ],
            "body": "json"
          },
          "thinkMs": 90000,
          "headers": {
            "origin": "{origin}"
          }
        },
        {
          "name": "page: article",
          "target": "client",
          "path": "/peru/lima/guides/a-beginners-guide-to-when-to-visit-lima-peru",
          "expect": {
