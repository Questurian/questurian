// Wrangler configuration for Questura Client on Cloudflare Workers, via the
// OpenNext adapter (ADR-0014). A TEMPLATE: nothing reads this file. Copy it
// to `wrangler.jsonc` at the client root when the adapter is installed.
//
// Every <PLACEHOLDER> is an owner decision or a provisioned resource name.
// No secret belongs in this file — secrets go in Worker secrets
// (`wrangler secret put`), and the two this app needs are named at the bottom.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "<WORKER_NAME>",

  // Pin the date the configuration was written against, not "today": the
  // compatibility date is what stops a platform change arriving as a
  // behaviour change in a release nobody touched.
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // The worker calls itself for the revalidation queue. The service name must
  // match "name" above.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "<WORKER_NAME>" }],

  // --- Cache components (opennext.js.org/cloudflare/caching) ---------------
  //
  // ISR needs the incremental cache and the queue.
  // revalidateTag / revalidatePath additionally need the tag cache, and need
  // cache purge to actually evict the CDN.
  //
  // Questura's whole publishing model is on-demand invalidation (ADR-0003),
  // so all four are required, not optional.

  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "<INCREMENTAL_CACHE_BUCKET>" }],

  "d1_databases": [{ "binding": "NEXT_TAG_CACHE_D1", "database_id": "<TAG_CACHE_D1_ID>", "database_name": "<TAG_CACHE_D1_NAME>" }],

  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_CACHE_DO_PURGE", "class_name": "BucketCachePurge" }
    ]
  },

  "images": { "binding": "IMAGES" },

  "vars": {
    // Public, non-secret. The backend origin this frontend renders from.
    "NEXT_PUBLIC_BACKEND_URL": "<BACKEND_ORIGIN>"
  }

  // --- Secrets, set with `wrangler secret put`, never in this file ---------
  //
  //   QUESTURA_REVALIDATION_SECRET  the backend presents this on
  //                                 POST /api/revalidate. Must match the
  //                                 backend's value or every publication is
  //                                 a 401 the outbox retries forever.
  //   QUESTURA_RENDER_TOKEN         identifies this frontend's server-side
  //                                 reads to the backend's render bucket.
  //                                 Server-only: it must never be NEXT_PUBLIC_.
  //   CLOUDFLARE_API_TOKEN          cache purge only. Needs the Cache Purge
  //   CLOUDFLARE_ZONE_ID            permission on this zone and nothing else.
}
