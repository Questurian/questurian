# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# production builds for capacity measurement (NEXT_DIST_DIR)
/.next-*/
/out/

# Cloudflare adapter (ADR-0014). `.open-next/` is build output; `.dev.vars`
# holds the local preview's secrets and must never be committed — the real
# ones are set with `wrangler secret put`.
/.open-next/
/.wrangler/
.dev.vars
.dev.vars.*

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude
CLAUDE.md
.claude/

# generated by scripts/sync-flag-assets.mjs
/public/flags
