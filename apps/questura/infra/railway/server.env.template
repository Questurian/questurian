# Questura Server on Railway: every variable the server reads.
#
# This file is the source of truth for the Railway service's variables.
# Check a filled copy before the first deploy, and before every change to them:
#
#   pnpm --dir apps/questura/apps/server env:check path/to/filled.env
#
# That runs the production boot check against the file alone (your shell's
# variables do not count), plus the checks below that only make sense on a
# real platform. `railway-template.test.ts` fails CI when the server starts
# reading a variable this file does not document.
#
# Format:
#   KEY=value        set this; the value shown is the intended one
#   KEY=<...>        set this; the angle brackets are a placeholder, and
#                    env:check refuses a file that still has one
#   # KEY=value      optional; leave unset for the default in the named file
#
# Never commit a filled copy. Secrets go in Railway's variable editor.
# Platform plan: docs/capacity/cap07-platform-readiness.md §1a, step list:
# docs/capacity/h01-provisioning-checklist.md Part B.

NODE_ENV=production

# --- Hosts --------------------------------------------------------------------
# The site and the API must be one registrable domain, or the visitor cookie
# (SameSite=Lax) is never sent and every reader looks signed out. Two
# *.up.railway.app hosts are two sites (up.railway.app is a public suffix).
NEXT_PUBLIC_APP_URL=https://www.questurian.com
# The API's own public origin. Hostname not final: soft-prod uses cms.questurian.com.
BACKEND_URL_LOCAL=https://api.questurian.com
# Where publications deliver revalidation, i.e. the Cloudflare Worker.
QUESTURA_CLIENT_URL=https://www.questurian.com
# Browser origins allowed to call the API with credentials. Defaults to the
# app and frontend URLs when unset. Never list localhost in production.
# CORS_ALLOWED_ORIGINS=https://www.questurian.com,https://questurian.com
# Legacy aliases the server still reads. Prefer the variables above.
# NEXT_PUBLIC_FRONTEND_URL=
# FRONTEND_URL=
# NEXT_PUBLIC_BACKEND_URL=

# --- Who is calling ------------------------------------------------------------
# No safe default: production refuses to boot without it. The Railway origin
# decision is ADR-0016 (docs/adr/0016-api-origin-identity-on-railway.md).
TRUSTED_PROXY=<cloudflare, per ADR-0016>

# The front door (ADR-0016). Cloudflare's Transform Rule sets this value as the
# X-Questura-Origin-Auth header on every request to the API host, Railway's edge
# rule allows only requests carrying it, and the app checks it again
# (src/shared/http/origin-auth.ts). Same value on the Cloudflare Worker, which
# sends it on its own renders. Not QUESTURA_RENDER_TOKEN: its own 64 characters.
# env:check refuses a file without it. /api/health and /api/health/ready answer
# without it (Railway's healthcheck calls the container directly).
ORIGIN_AUTH_SECRET=<64 random characters, shared with the Cloudflare rule and the Worker>
# refuse (default): 403 without the header. unidentified: served, but counted
# in the one shared rate-limit bucket.
# ORIGIN_AUTH_MODE=refuse

# --- Staff session cookie (Payload) --------------------------------------------
PAYLOAD_COOKIE_DOMAIN=questurian.com
# Every host that must receive the staff session. Payload's own host is added.
PAYLOAD_COOKIE_REQUIRED_HOSTS=api.questurian.com,www.questurian.com,abw.questurian.com,abw-api.questurian.com

# --- Secrets -------------------------------------------------------------------
# Fresh values, never the laptop's. 32+ characters each.
PAYLOAD_SECRET=<64 random characters>
BETTER_AUTH_SECRET=<64 random characters, not PAYLOAD_SECRET>
# Same value on the Cloudflare Worker.
QUESTURA_REVALIDATION_SECRET=<64 random characters, shared with the Worker>
# Legacy alias of QUESTURA_REVALIDATION_SECRET. Leave unset.
# REVALIDATION_SECRET=
# Gives frontend renders their own read budget. Also set on the Worker.
# QUESTURA_RENDER_TOKEN=
# Protect the internal endpoints the schedulers call (ADR-0015).
REFRESH_WORKER_SECRET=<64 random characters>
DB_STATS_SECRET=<64 random characters>
EXCHANGE_RATE_SYNC_SECRET=<64 random characters>

# --- Postgres (Neon) -----------------------------------------------------------
# Both the direct (unpooled) endpoint. Advisory locks need a session-level
# connection; behind a transaction pooler they silently stop coordinating.
DATABASE_URI=<Neon direct endpoint>
DATABASE_URI_UNPOOLED=<Neon direct endpoint>
# Older spelling of DATABASE_URI_UNPOOLED. Leave unset.
# DATABASE_URL_UNPOOLED=
# `SHOW max_connections` on the chosen Neon compute size.
DATABASE_MAX_CONNECTIONS=<SHOW max_connections>
# direct | pooled. Inferred from the hostname when unset (fleet-manifest.ts).
# DATABASE_TOPOLOGY=direct
# DATABASE_RESERVED_CONNECTIONS=
# DATABASE_POOLER_MAX_CLIENTS=
# DATABASE_POOLER_POOL_SIZE=
# Per-process pool maxima. Defaults 20 / 10 / 10 (shared/database/pool-budget.ts).
# DATABASE_POOL_PAYLOAD_MAX=
# DATABASE_POOL_VISITOR_AUTH_MAX=
# DATABASE_POOL_ADVISORY_LOCK_MAX=
# Timeouts (shared/database/timeouts.ts). Unset uses the measured defaults:
# statement 15000, client query 17000 (statement + 2000), connection 10000.
# PG_STATEMENT_TIMEOUT_MS=
# PG_LOCK_TIMEOUT_MS=
# PG_IDLE_IN_TRANSACTION_TIMEOUT_MS=
# PG_ADVISORY_LOCK_WAIT_MS=
# PG_QUERY_TIMEOUT_MS=
# PG_CONNECTION_TIMEOUT_MS=

# --- Fleet (shared/database/fleet-manifest.ts, pool-budget.ts) -----------------
# The service's autoscale cap, counted in processes.
APP_PROCESS_COUNT=<autoscale cap>
# Extra instances alive during a rolling deploy.
APP_ROLLOUT_SURGE=1
# APP_REPLICA_COUNT=
# APP_PROCESSES_PER_REPLICA=
# APP_JOB_PROCESS_COUNT=
# serve | job
# APP_ROLE=
# The previous generation during a rollout, when its pools differ.
# APP_PREVIOUS_PROCESS_COUNT=
# APP_PREVIOUS_PER_PROCESS_CONNECTIONS=
# APP_PREVIOUS_POOL_PAYLOAD_MAX=
# APP_PREVIOUS_POOL_VISITOR_AUTH_MAX=
# APP_PREVIOUS_POOL_ADVISORY_LOCK_MAX=
# A stable per-instance identity for per-process evidence.
# QUESTURA_INSTANCE_ID=
# Set by the build.
# QUESTURA_RELEASE_SHA=
# 1 = crash on failed first database init instead of retrying (instrumentation.ts).
# BOOT_FAIL_FAST=

# --- Redis (Railway Redis, same project) ---------------------------------------
REDIS_URL=<Railway Redis private URL>

# --- Stripe (live) --------------------------------------------------------------
# Live mode only. env:check refuses test-mode keys in this file.
STRIPE_SECRET_KEY=<rk_live_... restricted key>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=<pk_live_...>
# The signing secret of the endpoint registered for this host.
STRIPE_WEBHOOK_SECRET=<whsec_... for https://api.questurian.com/api/payments/webhooks/stripe>
# Catalog prices: $12.99/month and $79.99/year (docs/membership-pricing.md).
STRIPE_PRICE_ID_MONTHLY=<price_... $12.99/month>
STRIPE_PRICE_ID_YEARLY=<price_... $79.99/year>
# Older name for the monthly price. Leave unset.
# STRIPE_PRICE_ID=
# Defaults to <NEXT_PUBLIC_APP_URL>/account.
# STRIPE_PORTAL_RETURN_URL=
# STRIPE_PROMOTION_CODES=false
# STRIPE_FORCE_3DS=false

# --- Email, sign-in, bot protection, images -------------------------------------
RESEND_API_KEY=<re_... sending-only key for questurian.com>
# The sender, on the site's domain (docs/procedures/email-domain.md). Required:
# env:check refuses a missing sender or one on another domain.
EMAIL_FROM_ADDRESS=<e.g. hello@questurian.com>
# EMAIL_FROM_NAME=Questurian
# Where replies go when the sender is not a monitored mailbox.
# EMAIL_REPLY_TO=
# EMAIL_TRACKING=true
GOOGLE_CLIENT_ID=<Google OAuth client id>
GOOGLE_CLIENT_SECRET=<Google OAuth client secret>
# ENFORCE_PASSWORD_STRENGTH=true
# TURNSTILE_AUTH_ENABLED=false
# TURNSTILE_SECRET_KEY=
BUNNY_STORAGE_API_KEY=<Bunny storage key>
# The pull zone readers load images from (e.g. questurian-cdn.b-cdn.net), NOT
# the storage API storage.bunnycdn.com. Every image address is built from it.
BUNNY_STORAGE_HOSTNAME=<Bunny pull zone hostname>
BUNNY_STORAGE_ZONE_NAME=<Bunny storage zone>
# ENDORSELY_ENABLED=false

# --- Error reporting (docs/procedures/sentry-setup.md) --------------------------
# The Questura server project's DSN. env:check refuses a file without one: the
# server boots without it (development, sandbox and CI never set it), but a
# real platform without it has errors nobody is told about.
SENTRY_DSN=<DSN of the questura-server Sentry project, https://...ingest.sentry.io/...>
# Defaults to "production" when NODE_ENV=production.
# SENTRY_ENVIRONMENT=production
# The release tag on every event is QUESTURA_RELEASE_SHA (above).

# --- Publishing -----------------------------------------------------------------
# REFRESH_WORKER_INTERVAL_MS=
# `off` is a degraded emergency mode and needs REFRESH_OUTBOX_DEGRADED_ACK.
# REFRESH_OUTBOX=
# REFRESH_OUTBOX_DEGRADED_ACK=
# HOMEPAGE_FEATURED_ALLOW_DRAFTS=false
# CURRENCY_STARTUP_SYNC=

# --- Admission gates and read limits (shared/http/admission.ts) ------------------
# <GATE>_CONCURRENCY / _QUEUE / _QUEUE_MS. Defaults live in admission.ts.
# PUBLIC_QUERY_CONCURRENCY=
# PUBLIC_QUERY_QUEUE=
# PUBLIC_QUERY_QUEUE_MS=
# PUBLIC_ASSEMBLY_CONCURRENCY=
# PUBLIC_ASSEMBLY_QUEUE=
# PUBLIC_ASSEMBLY_QUEUE_MS=
# PUBLIC_INGRESS_CONCURRENCY=
# PUBLIC_INGRESS_QUEUE=
# PUBLIC_INGRESS_QUEUE_MS=
# PRIVATE_READ_CONCURRENCY=
# PRIVATE_READ_QUEUE=
# PRIVATE_READ_QUEUE_MS=
# MOUNT_CREDENTIAL_CONCURRENCY=
# MOUNT_CREDENTIAL_QUEUE=
# MOUNT_CREDENTIAL_QUEUE_MS=
# MOUNT_STAFF_CONCURRENCY=
# MOUNT_STAFF_QUEUE=
# MOUNT_STAFF_QUEUE_MS=
# VISITOR_AUTH_CONCURRENCY=
# VISITOR_AUTH_QUEUE=
# VISITOR_AUTH_QUEUE_MS=
# SESSION_TRAFFIC_PER_SESSION=
# SESSION_TRAFFIC_PER_IP=
# PAGE_READ_BUDGET=
# PUBLIC_READ_RENDER_MULTIPLIER=
# PUBLIC_API_DIAGNOSTICS=
# PROBE_TTL_MS=
# VISITOR_AUTH_SCHEMA_GUARD=

# --- Must NOT be set in production ----------------------------------------------
# env:check refuses a file that sets any of these.
#   READINESS_SANDBOX, READINESS_STRIPE_STUB_URL (sandbox only: every Stripe
#     call would go to loopback and fail)
#   REFRESH_DISCONNECTED (every refresh reported skipped; publishing does nothing)
