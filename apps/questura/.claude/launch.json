{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "questura-server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "apps/server", "dev"],
      "port": 4000
    },
    {
      "name": "questura-server-offline",
      "runtimeExecutable": "env",
      "runtimeArgs": ["RESEND_API_KEY=", "STRIPE_SECRET_KEY=", "pnpm", "--dir", "apps/server", "dev"],
      "port": 4000
    },
    {
      "name": "questura-client",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "apps/client", "dev"],
      "port": 3000
    }
  ]
}
