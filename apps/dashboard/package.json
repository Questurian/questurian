{
  "name": "@questurian/dashboard",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev-web.ts",
    "dev:web": "bun run scripts/dev-web.ts",
    "dev:tui": "bun run --watch src/index.ts",
    "dev:clean": "pnpm install --filter @questurian/dashboard... && bun run scripts/dev-web.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "build:web": "vite build",
    "seed:usage": "bun run scripts/seed-usage.ts",
    "lint": "pnpm exec tsc --noEmit -p tsconfig.json && pnpm exec tsc --noEmit -p tsconfig.web.json",
    "test": "bun test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.12",
    "hono": "^4.6.0",
    "ink": "^6.6.0",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.3",
    "react-devtools-core": "^6.1.5",
    "react-dom": "^19.2.3",
    "recharts": "^3.10.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "latest",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "bun": "^1.3.9",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  }
}
