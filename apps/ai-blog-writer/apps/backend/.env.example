WEAVIATE_URL=http://weaviate:8080
WEAVIATE_VECTORIZER_MODULE=none
PIPELINE_VERSION=0.1.0
DATA_DIR=data/runs
OUTPUT_DIR=output

# Payload CMS base URL.
# Local backend (non-Docker): http://localhost:4000
# Backend in Docker talking to host Payload: http://host.docker.internal:4000
PAYLOAD_API_URL=http://localhost:4000

# Google Cloud / Vertex AI configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
