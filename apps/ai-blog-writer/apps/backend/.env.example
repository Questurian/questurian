WEAVIATE_URL=http://weaviate:8080
WEAVIATE_VECTORIZER_MODULE=none
PIPELINE_VERSION=0.1.0
DATA_DIR=data/runs
OUTPUT_DIR=output

# Payload CMS base URL.
# Local backend (non-Docker): http://localhost:4000
# Backend in Docker talking to host Payload: http://host.docker.internal:4000
PAYLOAD_API_URL=http://localhost:4000

# Google Cloud / Vertex AI configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# API access control. When ABW_API_KEY is set, every request (except
# /health and CORS preflight) must send a matching X-API-Key header.
# Leave empty for local development. REQUIRED for any deployment
# reachable beyond localhost: without it the API is fully open —
# anyone can start Vertex AI pipeline runs or wipe run history.
ABW_API_KEY=

# Comma-separated list of allowed browser origins, e.g.
# http://localhost:3003,https://abw.example.com
# Empty means wildcard (*), which also disables credentialed CORS.
ABW_ALLOWED_ORIGINS=

# Expose raw exception text in API error responses (dev/debug only).
# Keep false in production to avoid leaking internals.
API_EXPOSE_ERROR_DETAILS=false

# LangSmith tracing (LangGraph run visibility).
# Set tracing=true and API key to enable run traces + trace URLs in responses.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-blog-writer
# Optional: required when one API key belongs to multiple workspaces.
LANGSMITH_WORKSPACE_ID=

# Pexels API key for image search previews in staging
PEXELS_API_KEY=your-pexels-api-key

# Unsplash API credentials for image search previews in staging
UNSPLASH_APPLICATION_ID=your-unsplash-application-id
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
UNSPLASH_SECRET_KEY=your-unsplash-secret-key

# Black Forest Labs FLUX.2 image editing
BFL_API_KEY=your-bfl-api-key
BFL_BASE_URL=https://api.bfl.ai
BFL_MODEL_ID=flux-2-pro-preview

# Location Manager — base URL used by listicle blurb generation to enrich
# prompts with canonical venue facts and the Reviews Digest.
LM_API_URL=http://localhost:4002

# Anthropic — required when the listicle writer model is set to claude-opus-4-7.
# Get a key at https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=
