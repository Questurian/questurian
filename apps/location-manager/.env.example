# Google Maps API (optional - geocoding will be disabled if not set)
GOOGLE_MAPS_API_KEY=

# Instagram RapidAPI (optional - media download will be disabled if not set)
RAPID_API_KEY=

# Google Cloud / Vertex AI (required for Python alt-text service)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# BigDataCloud API (required for timezone lookup)
BIGDATACLOUD_API_KEY=

# Server Configuration
PORT=4002
NODE_ENV=development
