# Google Maps API (optional - geocoding will be disabled if not set)
GOOGLE_MAPS_API_KEY=

# Instagram RapidAPI (optional - media download will be disabled if not set)
RAPID_API_KEY=

# Geoapify API (optional - Brazil reverse geocoding limited without it)
# Sign up at https://www.geoapify.com/ (Free tier: 3000 requests/day)
GEOAPIFY_API_KEY=

# BigDataCloud API (required for timezone lookup)
BIGDATACLOUD_API_KEY=

# Foursquare Places API (optional - enriches accommodations amenity fields)
FOURSQUARE_API_KEY=

# Google Cloud / Vertex AI (required for Python alt-text service)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Server Configuration
PORT=4002
NODE_ENV=development

# Data paths (optional - uses defaults if not set)
DB_PATH=packages/server/data/location.sqlite
IMAGES_PATH=packages/server/data/images

# Payload CMS Integration (optional - sync to Payload disabled if not set)
# Configure these to enable one-way sync from url-util to Payload CMS
PAYLOAD_API_URL=http://localhost:4000
PAYLOAD_SERVICE_EMAIL=service-account@questurian.com
PAYLOAD_SERVICE_PASSWORD=your-strong-password

# IPRoyal residential proxy — used by tour-import (Viator) and the generic
# rendered-fetch scrape service. Leave blank to run the browser unproxied.
IPROYAL_HOST=
IPROYAL_PORT=
IPROYAL_USER=
IPROYAL_PASS=
PROXY_COUNTRY=us
# Set to "false" to run the rendered-fetch browser headful (debugging).
RENDERED_FETCH_HEADLESS=true
