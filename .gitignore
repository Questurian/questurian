# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
**/.vscode/

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Environment files - NEVER commit these
.env
.env.local
.env.*.local
*.pem

# AI assistant local docs/config
AGENTS.md
agents.md
CLAUDE.md
claude.md
.claude/settings.local.json

.nx/cache
.nx/workspace-data

.turbo/

# Meta-repo safety: block generated artifacts from nested repos
**/node_modules/
**/.turbo/
**/.nx/cache/
**/.nx/workspace-data/
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template
**/*.log

# Runtime/generated data (location-manager)
apps/location-manager/packages/server/data/location.sqlite
apps/location-manager/packages/server/src/data/location.sqlite
apps/location-manager/packages/server/data/reviews/
apps/location-manager/packages/server/data/merged-reviews/
apps/location-manager/packages/server/data/tripadvisor-places/
apps/location-manager/packages/server/data/tripadvisor-reviews/
