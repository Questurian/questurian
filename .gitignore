apps/location-manager/packages/server/data/location.sqlite
apps/location-manager/packages/server/src/data/location.sqlite
apps/location-manager/packages/server/data/reviews/
apps/location-manager/packages/server/data/merged-reviews/
apps/location-manager/packages/server/data/tripadvisor-places/
apps/location-manager/packages/server/data/tripadvisor-reviews/
apps/location-manager/packages/server/data/*.bak-*
apps/location-manager/packages/server/data/images.bak-*/
