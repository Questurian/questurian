{
  "name": "@questurian/source",
  "version": "0.0.0",
  "packageManager": "pnpm@10.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dashboard": "turbo run dev:tui --concurrency=20 --filter=@questurian/dashboard",
    "dashboard:web": "turbo run dev --concurrency=20 --filter=@questurian/dashboard",
    "dashboard:clean": "turbo run dev:clean --concurrency=20 --filter=@questurian/dashboard",
    "questura": "turbo run dev --concurrency=20 --filter=@questura/client --filter=@questura/server",
    "questura:client": "turbo run dev --concurrency=20 --filter=@questura/client",
    "questura:server": "turbo run dev --concurrency=20 --filter=@questura/server",
    "dev": "turbo run dev --concurrency=20 --filter=!@questurian/abw-converter",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "dependencies": {},
  "devDependencies": {
    "turbo": "^2.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bun",
      "esbuild",
      "nx",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "shell-quote@<1.8.4": "1.8.4",
      "handlebars@<4.7.9": "4.7.9",
      "@types/react": "19.2.10",
      "@types/react-dom": "19.2.3",
      "lodash@>=4.0.0 <4.18.0": "^4.18.0",
      "fast-uri@>=3.0.0 <3.1.6": "^3.1.6",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "dompurify@>=3.0.0 <3.4.13": "^3.4.13",
      "immutable@>=4.0.0 <4.3.9": "^4.3.9",
      "picomatch@>=2.0.0 <2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "browserslist@>=4.0.0 <4.28.7": "^4.28.7",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "^2.11.0",
      "yaml@>=1.0.0 <1.10.3": "^1.10.3",
      "fast-xml-parser@>=5.0.0 <5.7.0": "^5.7.0",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "next@15>sharp": "^0.35.4",
      "brace-expansion@>=1.0.0 <1.1.18": "^1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
      "minimatch@>=3.0.0 <3.1.4": "^3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "flatted@>=3.0.0 <3.4.2": "^3.4.2",
      "ajv@>=6.0.0 <6.14.0": "^6.14.0",
      "@humanfs/node@>=0.16.0 <0.16.8": "^0.16.8",
      "@babel/core@>=7.0.0 <7.29.6": "^7.29.6",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18",
      "postcss@>=8.0.0 <8.5.23": "^8.5.23",
      "rollup@>=4.0.0 <4.59.0": "^4.59.0",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "qs@>=6.0.0 <6.16.0": "^6.16.0"
    }
  }
}
